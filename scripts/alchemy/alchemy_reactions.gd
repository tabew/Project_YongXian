static func _key(a_id: int, b_id: int) -> String:
	return "%d/%d" % [mini(a_id, b_id), maxi(a_id, b_id)]


## 两个属性之间有没有反应（抵消也算有反应）
static func has_reaction(a_id: int, b_id: int) -> bool:
	if a_id == b_id:
		return SAME.has(a_id)
	return TABLE.has(_key(a_id, b_id))


## 取反应：{} = 不会反应；{products, vanish} = 有反应
static func lookup(a_id: int, b_id: int) -> Dictionary:
	var products: Array = []

	if a_id == b_id:
		if !SAME.has(a_id):
			return {}
		products = SAME[a_id]
	else:
		var key: String = _key(a_id, b_id)

		if !TABLE.has(key):
			return {}
		products = TABLE[key]
	return {"products": products, "vanish": products.is_empty()}
